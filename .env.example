# 환경변수 키 목록. 값은 비워 둔다. 비밀값은 VITE_ 변수에 넣지 않는다.

# DMS MCP 서버 주소. setup.sh가 읽어 AI 도구에 등록한다. 값은 디스코드의 .env.local 에서 받는다
DMS_MCP_URL=

# Figma 디자인 파일 주소. 공개 저장소라 값은 디스코드의 .env.local 에서 받는다
FIGMA_FILE_URL=

# Figma 개인 액세스 토큰. scripts/figma.mjs가 디자인을 받을 때 쓴다. 각자 만들고 공유하지 않는다(README "Figma 디자인")
FIGMA_TOKEN=

# 카카오 지도 JavaScript 키. 등록한 도메인에서만 동작하는 공개용 키다. REST·Admin 키는 넣지 않는다
VITE_KAKAO_MAP_KEY=
